{
  "name": "n8n-nodes-domailfix",
  "version": "1.0.0",
  "description": "Domailfix for n8n: verify email addresses, find work emails, check phone numbers and look up companies.",
  "keywords": [
    "n8n-community-node-package",
    "domailfix",
    "email verification",
    "email finder",
    "phone validation"
  ],
  "license": "MIT",
  "homepage": "https://domailfix.com/integrations#n8n",
  "author": {
    "name": "Achivix",
    "email": "support@domailfix.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domailfix/n8n-nodes-domailfix.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/DomailfixApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Domailfix/Domailfix.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
